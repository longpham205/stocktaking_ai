# Copy to .env (`make setup` does it and fills the secrets). Read by the API on the host
# (backend/app/core/config.py) and by docker compose. Never commit .env.

# ── Core ─────────────────────────────────────────────────────────────────────
# dev | test | prod  (generated API docs are served in dev only)
APP_ENV=dev
# Postgres through asyncpg. This default is compose's postgres published on the host (:5437);
# inside compose the services use their own URL.
DATABASE_URL=postgresql+asyncpg://stocktaking:stocktaking@127.0.0.1:5437/stocktaking
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs the login tokens. `make setup` generates it. Changing it logs everyone out.
JWT_SECRET=
TOKEN_TTL_MINUTES=480
# wrong passwords allowed for one (account, IP) before a temporary lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# ── Recognition ──────────────────────────────────────────────────────────────
# local = load the engine in the API process (needs the ML extra: `uv sync --extra ml`, and weights)
# fake  = canned results, no torch (development without a GPU, tests)
RECOGNIZER=fake
# The engine's pipeline config, relative to backend/. config.demo.yaml = mock backends on CPU.
PIPELINE_CONFIG=configs/config.yaml
# Runtime assets (gallery, FAISS cache, capture images), relative to backend/
DATA_DIR=data

# ── Media ────────────────────────────────────────────────────────────────────
# Signs capture/gallery image URLs. `make setup` generates it.
MEDIA_URL_SECRET=
MEDIA_URL_TTL_SECONDS=3600

# ── POS ──────────────────────────────────────────────────────────────────────
# "Today" in history and reports is the shop's day (Vietnam: +7)
TIMEZONE_OFFSET_HOURS=7

# ── Docker build ─────────────────────────────────────────────────────────────
# none (light image, fake recognizer) | cpu | cu128 (set by docker-compose.gpu.yml)
TORCH_VARIANT=none
