# ==========================================
# 3. IDE & OS FILES
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 4. CONFIGURATION & SECRETS
# ==========================================
.env
.env.*

# ==========================================
# 5. ARCHIVES & COMPRESSED FILES
# ==========================================
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.tgz

# ==========================================
# 6. MODEL WEIGHTS (backend/weights)
# ==========================================
backend/weights/**/*.pth
backend/weights/**/*.pt
backend/weights/**/*.safetensors
backend/weights/**/*.bin
backend/weights/**/*.msgpack
backend/weights/**/*.h5
backend/weights/**/*.onnx
backend/weights/retriever/siglip2/*.json
backend/weights/retriever/siglip2/*.jinja
!backend/weights/**/.gitkeep

# ==========================================
# 7. DATA, CACHE, OUTPUTS & METADATA (backend/data, backend/data_demo)
# ==========================================

# Ignore everything inside data
backend/data/*
backend/data_demo/*

# Allow only required directory placeholders
!backend/data/gallery/
backend/data/gallery/*
!backend/data/gallery/.gitkeep

!backend/data/query/
backend/data/query/*
!backend/data/query/.gitkeep

!backend/data/outputs/
backend/data/outputs/*
!backend/data/outputs/.gitkeep

!backend/data/cache/
backend/data/cache/*
!backend/data/cache/.gitkeep

# Allow metadata directory, its hand-written files only
!backend/data/metadata/
backend/data/metadata/products.json
backend/data/metadata/product_ids.json

*.db
*.db-wal
*.db-shm

# ==========================================
# 7b. FRONTEND (Node / Vite)
# ==========================================
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# ==========================================
# 8. TEMPORARY FILES
# ==========================================
# Ghi chu phien lam viec + thu muc cho xoa (chi tren may)
NOTES.md
_trash/

# Tai lieu lam viec noi bo (chi tren may)
CLAUDE.md
docs/dev/

