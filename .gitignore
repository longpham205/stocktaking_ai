# ==========================================
# 1. PYTHON & VIRTUAL ENVIRONMENTS
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 2. TESTING & DEBUGGING
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
debug/
tests/
test.py

# ==========================================
# 3. IDE & OS FILES
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 4. CONFIGURATION & SECRETS
# ==========================================
.env
.env.*

# ==========================================
# 5. ARCHIVES & COMPRESSED FILES
# ==========================================
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.tgz

# ==========================================
# 6. MODEL WEIGHTS
# ==========================================
weights/**/*.pth
weights/**/*.pt
weights/**/*.safetensors
weights/**/*.bin
weights/**/*.msgpack
weights/**/*.h5
weights/**/*.onnx
weights/retriever/siglip2/*.json
weights/retriever/siglip2/*.jinja
!weights/**/.gitkeep

# ==========================================
# 7. DATA, CACHE, OUTPUTS & METADATA
# ==========================================

# Ignore everything inside data
data/*

# Allow only required directory placeholders
data/gallery/
!data/gallery/.gitkeep

data/query/
!data/query/.gitkeep

data/outputs/
!data/outputs/.gitkeep

data/cache/
!data/cache/.gitkeep

# Allow metadata directory and ONLY product_colors.json
!data/metadata/
!data/metadata/product_colors.json

# Ignore generated metadata
data/metadata/products.json
data/metadata/product_ids.json

# ==========================================
# 8. TEMPORARY FILES
# ==========================================