*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
develop-eggs/
downloads/
eggs/
.eggs/
/backend/build/
/backend/dist/
/backend/lib/
/backend/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 2. TESTING & DEBUGGING
# ==========================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
